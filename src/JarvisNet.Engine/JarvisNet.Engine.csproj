<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JarvisNet.Core\JarvisNet.Core.csproj" />
    <ProjectReference Include="..\JarvisNet.Audio\JarvisNet.Audio.csproj" />
    <ProjectReference Include="..\JarvisNet.Plugins.Sdk\JarvisNet.Plugins.Sdk.csproj" />
  </ItemGroup>

  <Target Name="CopyJarvisSearchWebPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_SearchWebPluginDll>$(MSBuildThisFileDirectory)..\JarvisNet.SearchWeb\bin\$(Configuration)\$(TargetFramework)\JarvisNet.SearchWeb.dll</_SearchWebPluginDll>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\JarvisNet.SearchWeb\JarvisNet.SearchWeb.csproj"
      Properties="Configuration=$(Configuration)"
      Targets="Build"
      Condition="!Exists('$(_SearchWebPluginDll)')" />
    <MakeDir Directories="$(OutputPath)Plugins" Condition="!Exists('$(OutputPath)Plugins')" />
    <Copy
      SourceFiles="$(_SearchWebPluginDll)"
      DestinationFolder="$(OutputPath)Plugins"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_SearchWebPluginDll)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.80.1-alpha" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JarvisNet.Engine.UnitTests" />
  </ItemGroup>

</Project>
