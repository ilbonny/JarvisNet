<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JarvisNet.Audio\JarvisNet.Audio.csproj" />
    <ProjectReference Include="..\JarvisNet.Engine\JarvisNet.Engine.csproj" />
    <ProjectReference Include="..\JarvisNet.Camera\JarvisNet.Camera.csproj" />
    <ProjectReference Include="..\JarvisNet.Telegram\JarvisNet.Telegram.csproj" />
  </ItemGroup>

  <Target Name="CopyJarvisCameraPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_CameraPluginDll>$(MSBuildProjectDirectory)\..\JarvisNet.CameraPlugin\bin\$(Configuration)\$(TargetFramework)\JarvisNet.CameraPlugin.dll</_CameraPluginDll>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\JarvisNet.CameraPlugin\JarvisNet.CameraPlugin.csproj"
      Properties="Configuration=$(Configuration)"
      Targets="Build"
      Condition="!Exists('$(_CameraPluginDll)')" />
    <MakeDir Directories="$(OutputPath)Plugins" Condition="!Exists('$(OutputPath)Plugins')" />
    <Copy
      SourceFiles="$(_CameraPluginDll)"
      DestinationFolder="$(OutputPath)Plugins"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_CameraPluginDll)')" />
  </Target>

  <Target Name="CopyJarvisSearchWebPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_SearchWebPluginDll>$(MSBuildProjectDirectory)\..\JarvisNet.SearchWeb\bin\$(Configuration)\$(TargetFramework)\JarvisNet.SearchWeb.dll</_SearchWebPluginDll>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\JarvisNet.SearchWeb\JarvisNet.SearchWeb.csproj"
      Properties="Configuration=$(Configuration)"
      Targets="Build"
      Condition="!Exists('$(_SearchWebPluginDll)')" />
    <MakeDir Directories="$(OutputPath)Plugins" Condition="!Exists('$(OutputPath)Plugins')" />
    <Copy
      SourceFiles="$(_SearchWebPluginDll)"
      DestinationFolder="$(OutputPath)Plugins"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_SearchWebPluginDll)')" />
  </Target>

</Project>
