{
  "McpServers": {
    "Playwright": {
      "Command": "npx",
      "Args": ["-y", "@playwright/mcp@latest"],
      "Enabled": true,
      "Env": {}
    },
    "Slack": {
      "Command": "npx",
      "Args": ["-y", "slack-mcp-server@latest", "--transport", "stdio"],
      "Enabled": false,
      "Env": {}
    },
    "Gmail": {
      "Command": "npx",
      "Args": ["-y", "gmail-mcp-imap"],
      "Enabled": false,
      "Env": {}
    }
  }
}
